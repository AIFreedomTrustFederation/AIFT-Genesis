{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifreedomtrust.com/schemas/Tree.schema.json",
  "title": "AIFT Tree Manifest",
  "description": "Versioned directed attributed graph contract for the AIFT Tree of Emergence. Renderers project this graph into SVG, HTML, or application views; visual metadata is not authoritative meaning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "modelVersion",
    "modelId",
    "title",
    "status",
    "description",
    "parts",
    "epistemicClasses",
    "domains",
    "edgeRelations",
    "rootNodeIds",
    "primaryProjection",
    "sourceRefs",
    "nodes",
    "edges",
    "views",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "tree-manifest"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "modelVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "canonical-draft",
        "active",
        "deprecated"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "canonicalDocument": {
      "type": "string"
    },
    "legacyCompatibility": {
      "type": "object"
    },
    "parts": {
      "type": "array",
      "minItems": 7,
      "items": {
        "enum": [
          "seed",
          "roots",
          "trunk",
          "branches",
          "leaves",
          "fruit",
          "newSeeds"
        ]
      }
    },
    "epistemicClasses": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/classDefinition"
      },
      "minProperties": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "edgeRelations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "rootNodeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "primaryProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "edgeRole"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "edgeRole": {
          "const": "primary"
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "classDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "definition"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "uri",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "repository-document",
            "generated-artifact",
            "external-reference"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "shortLabel",
        "description",
        "domain",
        "epistemicClass",
        "status",
        "tags",
        "sourceRefs",
        "metadata",
        "presentationRole"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "shortLabel": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "$ref": "#/$defs/token"
        },
        "epistemicClass": {
          "$ref": "#/$defs/token"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "array",
              "object"
            ]
          }
        },
        "era": {
          "type": "string"
        },
        "timeRange": {
          "type": "string"
        },
        "parentHints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "symbol": {
          "type": "string"
        },
        "presentationRole": {
          "$ref": "#/$defs/token"
        },
        "canonicalUri": {
          "type": "string"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "relation",
        "epistemicClass",
        "role",
        "description",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "$ref": "#/$defs/token"
        },
        "epistemicClass": {
          "$ref": "#/$defs/token"
        },
        "role": {
          "enum": [
            "primary",
            "cross-link"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "description",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceDocuments",
        "schema",
        "generator",
        "validator",
        "generatedArtifacts",
        "lastGenerated",
        "sourceCommit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "sourceDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "validator": {
          "type": "string",
          "minLength": 1
        },
        "generatedArtifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastGenerated": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
