{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifreedomtrust.com/schemas/world-delta.schema.json",
  "title": "AIFT Living Federation World Delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "world_id",
    "base_revision",
    "revision",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": "aift.world.delta.v1"
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "entity_id",
              "value"
            ],
            "properties": {
              "op": {
                "const": "upsert-entity"
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/$defs/entity"
              },
              "evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "entity_id"
            ],
            "properties": {
              "op": {
                "const": "remove-entity"
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "relation_id",
              "value"
            ],
            "properties": {
              "op": {
                "const": "upsert-relation"
              },
              "relation_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/$defs/relation"
              },
              "evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "relation_id"
            ],
            "properties": {
              "op": {
                "const": "remove-relation"
              },
              "relation_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "revision",
        "position",
        "status",
        "evidence_refs",
        "visual"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "federation",
            "trust",
            "layer",
            "repository",
            "capability",
            "evidence",
            "event",
            "mission",
            "quest",
            "runtime",
            "application",
            "device",
            "location"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "$ref": "#/$defs/vector64"
        },
        "status": {
          "enum": [
            "planned",
            "detected",
            "ready",
            "active",
            "blocked",
            "deprecated",
            "removed"
          ]
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "properties": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "identity_phase",
            "coherence"
          ],
          "properties": {
            "form": {
              "type": "string"
            },
            "identity_phase": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 6.283185307179586
            },
            "coherence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "palette_token": {
              "type": "string"
            },
            "lod_priority": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "directed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "directed": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
